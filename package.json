{
  "name": "calm-plan",
  "version": "0.1.0",
  "description": "A bilingual (Arabic/English) self-help companion: daily to-do list with habits, mood check-ins, meditation and a supportive chat. Not therapy.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Orieb Alzyuot",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"node --watch server/index.js\" \"vite --config web/vite.config.ts\"",
    "build": "vite build --config web/vite.config.ts",
    "build:demo": "vite build --config web/vite.config.ts --mode demo",
    "build:demo:legacy": "node scripts/build-demo.mjs",
    "start": "node server/index.js",
    "test": "node --test test/*.test.js && vitest run --config web/vitest.config.ts",
    "test:server": "node --test test/*.test.js",
    "test:web": "vitest run --config web/vitest.config.ts",
    "typecheck": "tsc -p web/tsconfig.json"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "pelagic": "^0.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
